{
  "name": "ajd-break-tracker-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Break Tracker desktop app — AJD Apps",
  "main": "main.cjs",
  "scripts": {
    "start": "npm run prepare:icons && electron .",
    "dist:win": "npm run prepare:icons && electron-builder --win nsis --x64",
    "dist:mac": "npm run prepare:icons && electron-builder --mac dmg --universal",
    "prepare:icons": "node prepare-assets.cjs"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "org.ajdapp.breaktracker",
    "productName": "Break Tracker",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "intro.html",
      "icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Break-Tracker-Windows-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Break-Tracker-macOS.dmg"
    },
    "icon": "icon.png",
    "dmg": {
      "title": "Break Tracker",
      "backgroundColor": "#0f2628"
    }
  }
}
